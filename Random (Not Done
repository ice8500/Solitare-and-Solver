//Help Create Card
Card *createcard(int rank, char *suit){
    Card *card = (Card *)malloc(sizeof(Card));
    card->rank = rank;
    card->suit = suit;
    card->Faceup = 0; //Not used yet, will become 1 once it has been open
    card->next = NULL;
    card->prev = NULL;
    return card;
}//Implemented by 3448; To create a card in the doubly linked list

